{
  "name": "furniplan-desktop",
  "version": "1.0.90",
  "description": "FurniPlan - Smart Space Planning",
  "main": "desktop/main.js",
  "author": "سدير ياسين محمد",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sadeer.furniplan.v86",
    "productName": "FurniPlan",
    "artifactName": "FurniPlan-Setup-V90-${arch}.exe",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "catalog*.html",
      "manifest.webmanifest",
      "service-worker.js",
      "v13-ipad-fix.js",
      "v85-final-patch.js",
      "startup_splash.png",
      "v45*.*",
      "assets/**/*",
      "icons/**/*",
      "build/furniplan.ico",
      "desktop/main.js",
      "assistant*.json",
      "assistant*.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/furniplan.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FurniPlan",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/furniplan.ico",
      "uninstallerIcon": "build/furniplan.ico",
      "installerHeaderIcon": "build/furniplan.ico"
    }
  }
}