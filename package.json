{
  "name": "furniplan-v138-test",
  "version": "1.0.138",
  "description": "FurniPlan - Smart Space Planning",
  "main": "desktop/main.js",
  "author": "سدير ياسين محمد",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sadeer.furniplan.v138test",
    "productName": "FurniPlan V138 Test",
    "artifactName": "FurniPlan-V138-Test-Setup-${arch}.exe",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*",
      "!.git/**/*",
      "!.github/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/furniplan.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FurniPlan V138 Test",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/furniplan.ico",
      "uninstallerIcon": "build/furniplan.ico",
      "installerHeaderIcon": "build/furniplan.ico"
    },
    "compression": "normal"
  }
}
