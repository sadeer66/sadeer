{
  "name": "ses-desktop-activation-preview",
  "version": "0.2.0",
  "private": true,
  "description": "Isolated offline SES desktop preview with a central asset library",
  "author": "Sadeer Yaseen Mohammed",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "node license/check-key.cjs && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.sadeer.ses.activationpreview",
    "productName": "SES Activation Preview",
    "asar": true,
    "files": [
      "main.cjs",
      "server.cjs",
      "package.json",
      "license/core.cjs",
      "license/controller.cjs",
      "license/preload.cjs",
      "license/public-keys.json",
      "license/activation.html",
      "license/activation.js"
    ],
    "extraResources": [
      {
        "from": "Web",
        "to": "Web"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SES Activation Preview",
      "artifactName": "SES-Activation-Preview-${version}-Setup.${ext}"
    }
  }
}
