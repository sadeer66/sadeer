{
  "name": "wasoolat-desktop",
  "version": "1.0.20",
  "description": "برنامج الوصولات - النسخة النهائية V20",
  "main": "desktop/main.js",
  "author": "سدير ياسين محمد",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sadeer.wasoolat",
    "productName": "برنامج الوصولات",
    "artifactName": "Wasoolat-Setup-V20-${arch}.exe",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "icon-v20.png",
      "build/wasoolat.ico",
      "desktop/main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/wasoolat.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "برنامج الوصولات",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/wasoolat.ico",
      "uninstallerIcon": "build/wasoolat.ico",
      "installerHeaderIcon": "build/wasoolat.ico"
    }
  }
}