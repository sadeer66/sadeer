{
  "name": "wasoolat-desktop",
  "version": "1.0.26",
  "description": "الوصولات V26 – Offline PWA Final",
  "main": "desktop/main.js",
  "author": "سدير ياسين محمد",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sadeer.wasoolat",
    "productName": "الوصولات",
    "artifactName": "Wasoolat-Setup-V26-${arch}.exe",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "service-worker.js",
      "install.html",
      "icon-v20.png",
      "apple-touch-icon.png",
      "build/wasoolat.ico",
      "desktop/main.js"
    ],
    "win": {
      "target": [{"target":"nsis","arch":["x64"]}],
      "icon": "build/wasoolat.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "الوصولات",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/wasoolat.ico",
      "uninstallerIcon": "build/wasoolat.ico",
      "installerHeaderIcon": "build/wasoolat.ico"
    }
  }
}